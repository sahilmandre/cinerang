# TMDB — get from https://www.themoviedb.org/settings/api
# Use v3 api_key OR v4 read access token. App prefers the token if set.
#
# Server-only (recommended): never bundled to the browser, can be changed
# without a rebuild. Falls back to NEXT_PUBLIC_* when unset.
TMDB_API_KEY=
TMDB_ACCESS_TOKEN=
# Browser search (LiveSearch) needs a public credential — this one ships to clients.
NEXT_PUBLIC_TMDB_API_KEY=
NEXT_PUBLIC_TMDB_ACCESS_TOKEN=
