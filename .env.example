# TMDB — get from https://www.themoviedb.org/settings/api
# Use v3 api_key OR v4 read access token. App prefers the token if set.
#
# Server-only: never bundled to the browser, can be changed without a
# rebuild. Live search goes through /api/search, so no public key is needed.
TMDB_API_KEY=
TMDB_ACCESS_TOKEN=
# Legacy fallback only, read when the server-only values above are blank.
# Avoid: NEXT_PUBLIC_* values are inlined into the browser bundle.
NEXT_PUBLIC_TMDB_API_KEY=
NEXT_PUBLIC_TMDB_ACCESS_TOKEN=

# ── Accounts & sync (docs/auth-and-sync-plan.md) — all server-only ──────
# MongoDB Atlas SRV URI; the app uses the `cinerang` database.
MONGODB_URI=
# Random, different per environment: `openssl rand -base64 32`
BETTER_AUTH_SECRET=
# http://localhost:3000 locally, https://<your-domain> on Vercel
BETTER_AUTH_URL=http://localhost:3000
# Google Cloud Console → OAuth client (Web). Redirect URI:
#   <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional invite list — comma-separated Gmail addresses.
# Empty = open sign-up: any Google account can sign in.
ALLOWED_EMAILS=
# Owners of the admin panel (/admin) — comma-separated. Always admins;
# further admins can be made from the panel itself.
ADMIN_EMAILS=
# Vercel sends it to the daily keep-alive cron.
CRON_SECRET=
